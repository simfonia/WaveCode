        <field name="RATIO1">1</field>
        <field name="AMP1">1</field>
        <field name="WAVE2">0</field>
        <field name="RATIO2">2</field>
        <field name="AMP2">0.5</field>
        <field name="WAVE3">0</field>
        <field name="RATIO3">3</field>
        <field name="AMP3">0.33</field>
        <field name="WAVE4">0</field>
        <field name="RATIO4">4</field>
        <field name="AMP4">0.25</field>
        <field name="WAVE5">0</field>
        <field name="RATIO5">5</field>
        <field name="AMP5">0.2</field>
        <next>
          <block type="wc_component_adsr" id="Kx|~PqIv*^bjddoo8na@">
            <field name="A">0.1</field>
            <field name="D">0.1</field>
            <field name="S">0.7</field>
            <field name="R">0.2</field>
            <next>
              <block type="wc_component_volume" id="7S~Sg[~uv-p_f.}rEK^7">
                <field name="VOL">70</field>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
