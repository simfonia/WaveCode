  <block type="wc_comment" id="S#@?5a;SrKH#L6Fs)r,/" x="10" y="-250">
    <field name="TEXT">// Arduino程式碼&amp;#10;// 按鈕接 pin 4&amp;#10;// 按下送出0，放開送出1&amp;#10;&amp;#10;void setup() {&amp;#10;  pinMode(4, INPUT_PULLUP);&amp;#10;    Serial.begin(115200);&amp;#10;}&amp;#10;&amp;#10;void loop() {&amp;#10;    Serial.println(digitalRead(4));&amp;#10;    delay(1);&amp;#10;}&amp;#10;</field>
  </block>
