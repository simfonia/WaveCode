  <block type="wc_init" id="init_1" x="10" y="610">
    <statement name="DO">
      <block type="wc_serial_init" id="ser_1">
        <field name="PORT">COM6</field>
        <field name="BAUD">115200</field>
        <next>
          <block type="wc_text_print" id="print_1">
            <value name="TEXT">
              <shadow type="text" id="t1">
                <field name="TEXT">TTP229 Drum Pad Ready!</field>
              </shadow>
            </value>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="wc_serial_data_received" id="on_serial" x="10" y="730">
    <field name="DATA" id="serial_data_id">serial_data</field>
    <statement name="DO">
      <block type="wc_comment" id="qkpVvSCQRr}%7BU2^(3q">
        <field name="TEXT">擷取Serial送過來的TTP欄位，該欄位為16-bits字串，&amp;#10;由左至右分別對應TTP229上的1至16號按鍵。</field>
        <next>
          <block type="variables_set" id="VZk:wzlGz006bxw#tH8p" disabled-reasons="MANUALLY_DISABLED">
            <field name="VAR" id="iBhOr@:o9jy:SHI:u2X/">ttp</field>
            <value name="VALUE">
              <block type="wc_serial_get_field" id="[Zk9OndFs(+xuY%s}q[t">
                <field name="PREFIX">TTP</field>
              </block>
            </value>
            <next>
              <block type="wc_text_print" id=":#c~ZX,o[UR[dPHyh7(D" disabled-reasons="MANUALLY_DISABLED">
                <value name="TEXT">
                  <shadow type="text" id="Q3rFnr].@QPH!~~=?^XG">
                    <field name="TEXT">TTP229 Drum Pad Ready!</field>
                  </shadow>
                  <block type="variables_get" id="_sN#m[Pf%uiW,$d^#ojc">
                    <field name="VAR" id="iBhOr@:o9jy:SHI:u2X/">ttp</field>
                  </block>
                </value>
                <next>
                  <block type="controls_if" id="if_k1">
                    <value name="IF0">
                      <block type="wc_serial_check_ttp" id="check_1">
                        <field name="PREFIX">TTP</field>
                        <field name="KEY">1</field>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="wc_play_note_async" id="7$s@CR?0@LB6Dh4=L7yD">
                        <field name="INSTRUMENT">kick</field>
                        <value name="NOTE">
                          <shadow type="text" id="xRn/DDmU%W-Ji41|Omt1">
                            <field name="TEXT">x</field>
                          </shadow>
                        </value>
                        <value name="DUR">
                          <shadow type="text" id="q`U.-7bCJRBu/AIL!@gg">
                            <field name="TEXT">0</field>
                          </shadow>
                        </value>
                        <value name="VELOCITY">
                          <shadow type="math_number" id="PtzgY%4/?.f`yIr%mu)~">
                            <field name="NUM">100</field>
                          </shadow>
                        </value>
                      </block>
                    </statement>
                    <next>
                      <block type="controls_if" id="if_k6">
                        <value name="IF0">
                          <block type="wc_serial_check_ttp" id="check_6">
                            <field name="PREFIX">TTP</field>
                            <field name="KEY">6</field>
                          </block>
                        </value>
                        <statement name="DO0">
                          <block type="wc_play_note_async" id=";1fXyc8cl7/TV0m~F+R_">
                            <field name="INSTRUMENT">snare</field>
                            <value name="NOTE">
                              <shadow type="text" id="hysOY|W}5n!WGF#/N,RL">
                                <field name="TEXT">x</field>
                              </shadow>
                            </value>
                            <value name="DUR">
                              <shadow type="text" id="o2rU,AWp;=%ko{RDHcul">
                                <field name="TEXT">0</field>
                              </shadow>
                            </value>
                            <value name="VELOCITY">
                              <shadow type="math_number" id="cX}`ToIL3NPK,KjhjJL3">
                                <field name="NUM">100</field>
                              </shadow>
                            </value>
                          </block>
                        </statement>
                        <next>
                          <block type="controls_if" id="if_k4">
                            <value name="IF0">
                              <block type="wc_serial_check_ttp" id="check_4">
                                <field name="PREFIX">TTP</field>
                                <field name="KEY">4</field>
                              </block>
                            </value>
                            <statement name="DO0">
                              <block type="wc_play_note_async" id="xKr0#iha}_!S!]{udPGd">
                                <field name="INSTRUMENT">chh</field>
                                <value name="NOTE">
                                  <shadow type="text" id="fE1q+xyR{Eaxe3=y^N!F">
                                    <field name="TEXT">x</field>
                                  </shadow>
                                </value>
                                <value name="DUR">
                                  <shadow type="text" id="$bX].E^AQ|`],sCOH1:w">
                                    <field name="TEXT">0</field>
                                  </shadow>
                                </value>
                                <value name="VELOCITY">
                                  <shadow type="math_number" id="{[89b35sS]T;wfG/(5~4">
                                    <field name="NUM">10</field>
                                  </shadow>
                                </value>
                              </block>
                            </statement>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
