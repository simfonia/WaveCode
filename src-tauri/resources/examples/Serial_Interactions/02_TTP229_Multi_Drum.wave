    <variable id="iBhOr@:o9jy:SHI:u2X/">ttp</variable>
  </variables>
  <block type="wc_master" id="HAwAKU4EXwpYKt7.sFTt" x="10" y="10">
    <statement name="CHAIN">
      <block type="wc_effect_compressor" id="A?~$HvXe/~A!/o7NLg.(">
