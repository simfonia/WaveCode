  <block type="wc_comment" id="{X?MKmyDg?1J2!1_e)q]" x="10" y="1090">
    <field name="TEXT">寫法1:&amp;#10;使用&lt;演奏&gt;積木搭配&lt;播放旋律&gt;積木進行多軌編曲，&amp;#10;手動輸入文字樂譜，裏面的積木會依序執行一次。</field>
  </block>
  <block type="wc_perform" id="*WyXTmG{QkY$rju/WonK" x="10" y="1190">
    <statement name="DO">
      <block type="wc_play_melody" id="PEpYHViLvgp,m3aLE25Q">
        <field name="INSTRUMENT">Kick</field>
        <field name="MELODY">XQ, RQ, XQ, RQ</field>
      </block>
    </statement>
  </block>
  <block type="wc_perform" id="O7c9cxdT/7*~xB;W@,sw" x="290" y="1190">
    <statement name="DO">
      <block type="wc_play_melody" id="NT.kxoTfTK5Q.SqB(9Ll">
        <field name="INSTRUMENT">Snare</field>
        <field name="MELODY">RQ, XQ, RQ, XQ</field>
      </block>
    </statement>
  </block>
  <block type="wc_perform" id="]91ucuDs+UC{G02AoQi~" x="570" y="1190">
    <statement name="DO">
      <block type="wc_play_melody" id="_zQ:mWJ|Nx+qv{[w1L$W">
        <field name="INSTRUMENT">HiHat_C</field>
        <field name="MELODY">XE XE XE XE XE XE XE XE </field>
