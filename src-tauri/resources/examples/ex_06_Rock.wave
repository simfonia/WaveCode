    </statement>
  </block>
  <block type="wc_comment" id=":efflOto1Y^+?46#3Z`c" x="10" y="1350">
    <field name="TEXT">寫法2:&amp;#10;使用&lt;演奏&gt;積木搭配&lt;序列器&gt;積木，裏面的積木會依序執行一次。</field>
  </block>
  <block type="wc_perform" id="0GT.}!V*L4T-aF_|]G+v" disabled-reasons="MANUALLY_DISABLED" x="10" y="1430">
    <statement name="DO">
      <block type="controls_repeat_ext" id="/|cIYb/@OEGNW%KdetvM">
        <value name="TIMES">
          <shadow type="math_number" id="WExf=cg[2t[66E|U|ytg">
            <field name="NUM">3</field>
          </shadow>
        </value>
        <statement name="DO">
          <block type="wc_rhythm_v2" id=";7/9v5a^645(7)xYKhRJ">
            <mutation items="3"></mutation>
            <field name="MEASURE">1</field>
            <field name="BEATS">4</field>
            <field name="RESOLUTION">4</field>
            <field name="INST0">Kick</field>
            <field name="VEL0">100</field>
            <field name="MODE0">FALSE</field>
            <field name="PATTERN0">x--- .... x--- ....</field>
            <field name="INST1">Snare</field>
            <field name="VEL1">100</field>
            <field name="MODE1">FALSE</field>
            <field name="PATTERN1">.... x--- .... x---</field>
            <field name="INST2">HiHat_C</field>
            <field name="VEL2">10</field>
            <field name="MODE2">FALSE</field>
            <field name="PATTERN2">x-x- x-x- x-x- x-x-</field>
          </block>
        </statement>
        <next>
          <block type="wc_rhythm_v2" id=".EvYC2RdyS6;LYnneD=6">
            <mutation items="3"></mutation>
            <field name="MEASURE">2</field>
            <field name="BEATS">4</field>
            <field name="RESOLUTION">4</field>
            <field name="INST0">Kick</field>
            <field name="VEL0">100</field>
            <field name="MODE0">FALSE</field>
            <field name="PATTERN0">x-x- x-x- x-x- x-x-</field>
            <field name="INST1">Snare</field>
            <field name="VEL1">100</field>
            <field name="MODE1">FALSE</field>
            <field name="PATTERN1">x-x- x-x- x-x- x-x-</field>
            <field name="INST2">Crash</field>
            <field name="VEL2">10</field>
            <field name="MODE2">FALSE</field>
            <field name="PATTERN2">---- ---- ---- --x-</field>
