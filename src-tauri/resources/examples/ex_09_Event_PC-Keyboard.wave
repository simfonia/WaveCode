      <block type="wc_sampler_percussion" id="!Cx994-/3P7s{0WJ?-x[">
        <field name="FOLDER">sound</field>
        <field name="FILE">windchimes-1</field>
        <next>
          <block type="wc_component_volume" id="q.:)*gx+PRW%P$?!CW}n">
            <field name="VOL">100</field>
          </block>
        </next>
      </block>
    </statement>
  </block>
