  <block type="wc_key_event" id="]7h^|EM8HEG@bJmKt,Vs" x="50" y="530">
    <field name="KEY">a</field>
    <field name="ACTION">down</field>
    <statement name="DO">
      <block type="wc_comment" id="zxW,vQvGr8m8EY-CcgBi">
        <field name="TEXT">使用"不等待"的發聲積木，並設為0拍，可由按鍵控制發聲時間，&amp;#10;方便即時演奏。</field>
        <next>
          <block type="wc_play_note_async" id="VOMW7,P?-yG~?^wZ8{Re">
            <field name="INSTRUMENT">Piano</field>
            <value name="NOTE">
              <shadow type="text" id="Pu2PyHw-q+EWjH_cNh}Q">
                <field name="TEXT">C4</field>
              </shadow>
            </value>
            <value name="DUR">
              <shadow type="text" id="+tk9o,KsPpUUTp4CNcwn">
                <field name="TEXT">0</field>
              </shadow>
            </value>
            <value name="VELOCITY">
              <shadow type="math_number" id="Py-~Xr+`*D#loQ*/dgen">
                <field name="NUM">100</field>
              </shadow>
            </value>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="wc_key_event" id="nX~`p2lLbWquGT:V:_VC" x="50" y="690">
    <field name="KEY">a</field>
    <field name="ACTION">up</field>
    <statement name="DO">
      <block type="wc_comment" id="8n3n(6%=yN7oUc?_/#Qo">
        <field name="TEXT">要記得釋放按鍵所觸發的樂器音符，否則會一直響下去。&amp;#10;若此時有其它演奏積木也使用Piano的C4音，會同時被消音。&amp;#10;解決方式是建立兩個樂器：Piano1 與 Piano2，&amp;#10;讓按鍵觸發的樂器使用Piano1，其它演奏的樂器使用Piano2。</field>
        <next>
          <block type="wc_release_note" id="L(p:TB_C(hE.l7/061fL">
            <field name="INSTRUMENT">Piano</field>
            <value name="NOTE">
              <shadow type="text" id="(HtesR+ah+aXr%ztujeG">
                <field name="TEXT">C4</field>
              </shadow>
            </value>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="wc_instrument" id=":gI?^o(}Gn16m0Tu)9%4" x="50" y="890">
    <field name="ID">Windchimes</field>
